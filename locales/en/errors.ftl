## Shared error messages. Errors cross IPC and HTTP as stable keys; the UI
## looks the message up here (or in the app's own errors.ftl).

error-generic = Something went wrong. Please try again.
error-network = The connection failed. Check your network and try again.
error-not-found = We could not find what you were looking for.
error-permission = You do not have permission to do this.
error-validation-required = This field is required.
error-validation-too-long = This value is too long (maximum { $max } characters).
error-file-unreadable = The file “{ $name }” could not be read.
error-file-too-large = The file is too large (maximum { $max } MB).
